<!DOCTYPE html>
<!-- movie-listing.html.tmpl: live TVmaze-backed movie and TV catalogue -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Movie and TV catalogue benchmark</title>
  <style>
    body {
      background: #f4f6f8;
      color: #172033;
      font-family: sans-serif;
      font-size: 9pt;
      margin: 0;
      padding: 16px;
    }
    h1 {
      color: #183b63;
      font-size: 18pt;
      margin: 0 0 5px;
    }
    .lede {
      color: #536273;
      margin: 0 0 12px;
    }
    .movie-card {
      background: #ffffff;
      border: 1px solid #cad3dc;
      display: inline-block;
      margin: 3px;
      min-height: 116px;
      padding: 6px;
      vertical-align: top;
      width: 286px;
    }
    .movie-card img {
      float: left;
      height: 108px;
      margin: 0 8px 4px 0;
      object-fit: cover;
      width: 72px;
    }
    .movie-card h2 {
      color: #183b63;
      font-size: 10pt;
      margin: 0 0 4px;
    }
    .movie-card p {
      margin: 3px 0;
    }
    .meta {
      color: #536273;
      font-size: 8pt;
    }
    .rating {
      color: #9a5b00;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <h1>Movie and TV catalogue</h1>
  <p class="lede">Live show metadata and poster images fetched from TVmaze.</p>
  <main>
  {{range .Items}}
    <article class="movie-card">
      {{if .ImageURL}}<img src="{{.ImageURL}}" alt="{{.Name}} poster">{{end}}
      <h2>{{.Name}}</h2>
      <p class="meta">{{.Type}} · {{.Language}} · {{.Premiered}}</p>
      <p>{{.Genres}}</p>
      <p>{{.Status}} · <span class="rating">{{.Rating}}</span></p>
    </article>
  {{end}}
  </main>
</body>
</html>
